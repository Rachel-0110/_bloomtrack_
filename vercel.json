{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/health", "dest": "/api/index.py" },
    { "src": "/stock", "dest": "/api/index.py" },
    { "src": "/stock/(.*)", "dest": "/api/index.py" },
    { "src": "/waste", "dest": "/api/index.py" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}